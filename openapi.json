              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignInMethods"
                }
              }
            }
          },
          "default": {
            "description": "An error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "summary": "Which sign-in options this server offers, for the sign-in screen.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/status": {
      "get": {
        "operationId": "StatusController_status",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "service",
                    "version",
                    "commit",
                    "environment",
                    "uptimeSeconds",
                    "ready",
                    "checks"
                  ],
                  "properties": {
                    "service": {
                      "type": "string",
                      "enum": [
                        "sotto-api"
                      ]
                    },
                    "version": {
                      "type": "string"
                    },
                    "commit": {
                      "type": "string"
                    },
                    "environment": {
                      "type": "string"
                    },
                    "uptimeSeconds": {
                      "type": "integer"
                    },
                    "ready": {
                      "type": "boolean"
                    },
                    "checks": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "boolean"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Public build and dependency summary, used by the web status page.",
        "tags": [
          "status"
        ]
      }
    },
