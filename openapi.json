            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "SignInMethods": {
        "type": "object",
        "properties": {
          "magicLink": {
            "type": "boolean"
          },
          "passkey": {
            "type": "boolean"
          },
          "google": {
            "type": "boolean"
          },
          "microsoft": {
            "type": "boolean"
          }
