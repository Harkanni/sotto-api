              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "summary": "Rename the active workspace (admins and owners).",
        "tags": [
          "workspaces"
        ]
      }
    },
    "/api/v1/members": {
      "get": {
        "operationId": "MembersController_list",
        "parameters": [],
        "responses": {
