            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "name",
          "role",
          "active",
          "members"
        ],
        "additionalProperties": false
      },
      "CreateWorkspace": {
