    "description": "Private AI for your team’s memos and meetings. Sign-in lives at /api/auth (Better Auth); writes need the session cookie and the X-CSRF-Token from GET /api/v1/me.",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sotto.session_token"
      }
    },
