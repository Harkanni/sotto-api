            "required": [
              "id",
              "name",
              "role",
              "sample"
            ],
            "additionalProperties": false
          },
          "csrfToken": {
            "type": "string"
          }
        },
        "required": [
          "user",
          "workspace",
          "csrfToken"
        ],
        "additionalProperties": false
      },
      "Handedness": {
        "type": "string",
        "enum": [
          "right",
          "left"
        ]
      },
      "Role": {
        "type": "string",
        "enum": [
          "owner",
          "admin",
          "member",
          "viewer"
        ]
      },
