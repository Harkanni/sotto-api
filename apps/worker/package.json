{
  "name": "@sotto/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput & sleep 5 && node --watch-path=dist --env-file-if-exists=../../.env dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@sotto/ai": "workspace:*",
    "@sotto/config": "workspace:*",
    "@sotto/contracts": "workspace:*",
    "@sotto/db": "workspace:*",
    "@sotto/storage": "workspace:*",
    "amqplib": "^0.10.9",
    "ioredis": "^5.11.0",
    "mammoth": "^1.13.0",
    "unpdf": "^1.8.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.7",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "vitest": "^4.1.0"
  }
}
