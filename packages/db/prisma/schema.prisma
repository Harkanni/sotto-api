// Sotto database schema.
// Each phase adds its models from sotto-platform/docs/PLAN.md → Data model. Conventions:
//   - snake_case table and column names via @@map / @map
//   - every tenant-owned table has workspace_id; request code reaches those tables only through
//     the tenant-scoped client (src/tenant.ts), which adds it to every query
//   - Postgres extensions (vector, pg_trgm, citext) and CHECK constraints live in raw SQL migrations

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ── Accounts ────────────────────────────────────────────────────────────────────────────────
// Shaped by Better Auth (apps/api/src/auth): it creates and reads these rows, and checks at
// startup that every field it writes exists. Its organization plugin is renamed Workspace,
// Membership and Invite, so there is one record of who belongs where. Better Auth generates the
// ids of its rows (opaque random strings); the defaults here only cover rows made elsewhere.

/// Roles inside a workspace, stored lowercase because Better Auth writes them as text.
enum Role {
  owner
  admin
  member
  viewer

  @@map("role")
}

/// Better Auth's invitation states. Expiry is a date, not a state; the API reports it.
enum InviteStatus {
  pending
  accepted
  rejected
  canceled

  @@map("invite_status")
}

/// Which side the + button sits on (Profile → Appearance).
enum Handedness {
  RIGHT
  LEFT

  @@map("handedness")
}

model User {
  id            String                 @id @default(cuid(2))
  /// Magic-link sign-ups start without a name; onboarding asks for one.
  name          String                 @default("")
  email         String                 @unique @db.Citext
  emailVerified Boolean                @default(false) @map("email_verified")
  image         String?
  handedness    Handedness             @default(RIGHT)
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @default(now()) @updatedAt @map("updated_at")
  sessions      Session[]
  accounts      Account[]
  passkeys      Passkey[]
  memberships   Membership[]
  invitesSent   Invite[]               @relation("InviteInviter")
  grants        CollectionPermission[]
  auditEntries  AuditLog[]
  files         File[]
  positions     PlaybackPosition[]
  conversations Conversation[]

  @@map("users")
}

model Session {
  id                String     @id @default(cuid(2))
  userId            String     @map("user_id")
  /// The cookie value. Better Auth signs the cookie; this is what it looks up.
  token             String     @unique
  expiresAt         DateTime   @map("expires_at")
  ipAddress         String?    @map("ip_address")
  userAgent         String?    @map("user_agent")
  /// The workspace every /api/v1 request acts in. Set by sign-in, create and activate.
  activeWorkspaceId String?    @map("active_workspace_id")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @default(now()) @updatedAt @map("updated_at")
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeWorkspace   Workspace? @relation(fields: [activeWorkspaceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("sessions")
}

/// A sign-in method linked to a user: Google, Microsoft (and, by Better Auth's design, its own
/// "credential" provider, which Sotto doesn't enable). OAuth tokens are encrypted by Better Auth.
model Account {
  id                    String    @id @default(cuid(2))
  userId                String    @map("user_id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

/// One-time values: magic-link tokens (stored hashed) and OAuth state.
model Verification {
  id         String   @id @default(cuid(2))
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

model Passkey {
  id           String    @id @default(cuid(2))
  userId       String    @map("user_id")
  /// What the person sees in Profile → Passkeys, e.g. "iCloud Keychain".
  name         String?
  publicKey    String    @map("public_key")
  credentialID String    @unique @map("credential_id")
  counter      Int
  deviceType   String    @map("device_type")
  backedUp     Boolean   @map("backed_up")
  transports   String?
  aaguid       String?
  createdAt    DateTime? @default(now()) @map("created_at")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkeys")
}

/// Better Auth's "organization".
model Workspace {
  id            String                 @id @default(cuid(2))
  name          String
  /// Required by Better Auth; never used in URLs (the workspace comes from the session).
  slug          String                 @unique
  logo          String?
  /// JSON text owned by the API, e.g. the sample collections loaded during onboarding.
  metadata      String?
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @default(now()) @updatedAt @map("updated_at")
  memberships   Membership[]
  invites       Invite[]
  sessions      Session[]
  collections   Collection[]
  grants        CollectionPermission[]
  auditLog      AuditLog[]
  files         File[]
  transcripts   Transcript[]
  segments      TranscriptSegment[]
  insights      MeetingInsights[]
  positions     PlaybackPosition[]
  chunks        Chunk[]
  embeddings    ChunkEmbedding[]
  integrations  Integration[]
  retention     RetentionPolicy[]
  legalHolds    LegalHold[]
  conversations Conversation[]
  messages      Message[]
  citations     Citation[]
  notes         Note[]
  aiProviders   AiProviderConfig[]
  aiPolicy      WorkspaceAiPolicy?
  usage         UsageEvent[]
  subscription  Subscription?

  @@map("workspaces")
}

/// Better Auth's "member".
model Membership {
  id          String    @id @default(cuid(2))
  workspaceId String    @map("workspace_id")
  userId      String    @map("user_id")
  role        Role      @default(member)
  createdAt   DateTime  @default(now()) @map("created_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("memberships")
}

/// Better Auth's "invitation". Its id is the secret in the invite link.
model Invite {
  id          String       @id @default(cuid(2))
  workspaceId String       @map("workspace_id")
  email       String       @db.Citext
  role        Role         @default(member)
  status      InviteStatus @default(pending)
  expiresAt   DateTime     @map("expires_at")
  inviterId   String       @map("inviter_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inviter     User         @relation("InviteInviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([email])
  @@map("invites")
}

// ── Content ─────────────────────────────────────────────────────────────────────────────────

/// Access a grant gives on a collection. Owners and admins always have Manage.
enum Access {
  VIEW
  EDIT
  MANAGE

  @@map("access")
}

model Collection {
  id          String                 @id @default(cuid(2))
  workspaceId String                 @map("workspace_id")
  name        String
  /// true → only people (or roles) with a grant can see and open it.
  restricted  Boolean                @default(false)
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @default(now()) @updatedAt @map("updated_at")
  workspace   Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  permissions CollectionPermission[]
  files       File[]

  @@index([workspaceId])
  @@map("collections")
}

/// A grant on a collection to one person or to everyone with a role (exactly one of the two,
/// enforced by a CHECK constraint in the migration).
model CollectionPermission {
  id           String     @id @default(cuid(2))
  workspaceId  String     @map("workspace_id")
  collectionId String     @map("collection_id")
  userId       String?    @map("user_id")
  role         Role?
  access       Access
  createdAt    DateTime   @default(now()) @map("created_at")
  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  user         User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([collectionId, userId])
  @@unique([collectionId, role])
  @@index([workspaceId, userId])
  @@map("collection_permissions")
}

/// What a file is. NOTE is written in Sotto (Phase 5); the other two are uploaded or recorded.
enum FileKind {
  DOCUMENT
  AUDIO
  NOTE

  @@map("file_kind")
}

/// The pipeline, in order. A failure at any step lands in FAILED with `error` set; Retry starts
/// over from UPLOADED.
enum FileStatus {
  UPLOADING
  UPLOADED
  TRANSCRIBING
  INDEXING
  READY
  FAILED

  @@map("file_status")
}

/// Decides which AI may read a file (BRIEF §3): Restricted only ever reaches in-cluster models.
enum Sensitivity {
  INTERNAL
  CONFIDENTIAL
  RESTRICTED

  @@map("sensitivity")
}

/// How a file arrived. IMPORT is reserved for the Next integrations (Drive, Notion, Slack, Zoom).
enum FileSource {
  UPLOAD
  RECORDING
  SAMPLE
  IMPORT
  /// Written in Sotto: a new note, or an answer saved as a note (Phase 5).
  WRITTEN

  @@map("file_source")
}

/// A document or a recording. Bytes live in object storage under
/// `files/<workspaceId>/<fileId>/`: `original` (as uploaded), plus what the pipeline derives
/// (`pages.json`, `transcript.json`, `peaks.json`). The database holds metadata, text chunks and
/// vectors.
model File {
  id            String             @id @default(cuid(2))
  workspaceId   String             @map("workspace_id")
  /// Unfiled when null (everyone in the workspace sees it; ADR 0016).
  collectionId  String?            @map("collection_id")
  /// Kept when the person leaves; null only if their account is deleted.
  ownerId       String?            @map("owner_id")
  kind          FileKind
  source        FileSource         @default(UPLOAD)
  title         String
  status        FileStatus         @default(UPLOADING)
  /// 0–1 within the current step (transcription reports it), for the status ring.
  progress      Float?
  sensitivity   Sensitivity        @default(INTERNAL)
  storageKey    String             @unique @map("storage_key")
  mime          String
  sizeBytes     BigInt             @map("size_bytes")
  /// sha256 of the original, computed by the worker (the browser shouldn't hash 500 MB).
  checksum      String?
  durationMs    Int?               @map("duration_ms")
  pageCount     Int?               @map("page_count")
  pinned        Boolean            @default(false)
  tags          String[]           @default([])
  /// The last failure as a code ("extract_failed", "audio_unreadable"), never content.
  error         String?
  /// S3 multipart upload id while UPLOADING; cleared on complete or abort.
  uploadId      String?            @map("upload_id")
  partSize      Int?               @map("part_size")
  /// Next: where an imported file came from.
  integrationId String?            @map("integration_id")
  /// Set when trashed; purged 30 days later.
  deletedAt     DateTime?          @map("deleted_at")
  /// When `status` last changed (the Processing widget orders by it).
  statusAt      DateTime           @default(now()) @map("status_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @default(now()) @updatedAt @map("updated_at")
  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  collection    Collection?        @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  owner         User?              @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  integration   Integration?       @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  transcript    Transcript?
  insights      MeetingInsights?
  chunks        Chunk[]
  positions     PlaybackPosition[]
  note          Note?
  citations     Citation[]

  @@index([workspaceId, deletedAt, createdAt(sort: Desc)])
  @@index([workspaceId, collectionId])
  @@index([workspaceId, status])
  @@index([workspaceId, checksum])
  @@map("files")
}

// ── Meetings ────────────────────────────────────────────────────────────────────────────────

model Transcript {
  id          String              @id @default(cuid(2))
  workspaceId String              @map("workspace_id")
  fileId      String              @unique @map("file_id")
  language    String
  /// e.g. "faster-whisper:base"; `isMock` marks the labelled mock engine's output.
  engine      String
  model       String
  isMock      Boolean             @default(false) @map("is_mock")
  createdAt   DateTime            @default(now()) @map("created_at")
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  file        File                @relation(fields: [fileId], references: [id], onDelete: Cascade)
  segments    TranscriptSegment[]

  @@map("transcripts")
}

/// One line of a transcript. Search within a transcript uses a trigram index on `text`
/// (created in the migration).
model TranscriptSegment {
  id           String     @id @default(cuid(2))
  workspaceId  String     @map("workspace_id")
  transcriptId String     @map("transcript_id")
  idx          Int
  speaker      String?
  startMs      Int        @map("start_ms")
  endMs        Int        @map("end_ms")
  text         String
  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transcript   Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  @@unique([transcriptId, idx])
  @@index([transcriptId, startMs])
  @@map("transcript_segments")
}

/// Where a model ran: drives the privacy rules and the data-route badge.
enum AiRoute {
  PRIVATE
  BYOK
  MANAGED

  @@map("ai_route")
}

/// Generated after transcription. The JSON shapes are `MeetingInsightsBody` in
/// packages/contracts (decisions, action items with owner and due date, questions, chapters).
model MeetingInsights {
  id            String    @id @default(cuid(2))
  workspaceId   String    @map("workspace_id")
  fileId        String    @unique @map("file_id")
  summary       String
  decisions     Json
  actionItems   Json      @map("action_items")
  openQuestions Json      @map("open_questions")
  chapters      Json
  model         String
  route         AiRoute
  isMock        Boolean   @default(false) @map("is_mock")
  createdAt     DateTime  @default(now()) @map("created_at")
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  file          File      @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@map("meeting_insights")
}

/// Where each person stopped listening ("Continue listening" on Home).
model PlaybackPosition {
  userId      String    @map("user_id")
  fileId      String    @map("file_id")
  workspaceId String    @map("workspace_id")
  positionMs  Int       @map("position_ms")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  file        File      @relation(fields: [fileId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, fileId])
  @@index([workspaceId, userId, updatedAt(sort: Desc)])
  @@map("playback_positions")
}

// ── Retrieval ───────────────────────────────────────────────────────────────────────────────

/// A passage of a file: a stretch of a page, or a window of a recording. `collectionId` and
/// `sensitivity` are copied from the file so permission and privacy filters stay inside SQL;
/// the API rewrites them when a file moves or is relabelled. `tsv` is a generated column (raw
/// SQL in the migration) with a GIN index for keyword search.
model Chunk {
  id           String                   @id @default(cuid(2))
  workspaceId  String                   @map("workspace_id")
  fileId       String                   @map("file_id")
  collectionId String?                  @map("collection_id")
  sensitivity  Sensitivity
  idx          Int
  text         String
  tokenCount   Int                      @map("token_count")
  page         Int?
  startMs      Int?                     @map("start_ms")
  endMs        Int?                     @map("end_ms")
  tsv          Unsupported("tsvector")?
  workspace    Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  file         File                     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  embeddings   ChunkEmbedding[]
  citations    Citation[]

  @@unique([fileId, idx])
  @@index([workspaceId, collectionId, sensitivity])
  @@map("chunks")
}

/// One vector per chunk per embedding model, so a new model is indexed beside the old one and
/// searches switch when it's done (PLAN → Swappable AI providers). `embedding` has no fixed
/// dimension here; each model gets its own partial HNSW index with a cast to its size, created
/// when its EmbeddingIndex row is (packages/db/src/vectors.ts).
model ChunkEmbedding {
  chunkId     String                @map("chunk_id")
  model       String
  workspaceId String                @map("workspace_id")
  dims        Int
  embedding   Unsupported("vector")
  chunk       Chunk                 @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([chunkId, model])
  @@index([workspaceId, model])
  @@map("chunk_embeddings")
}

enum IndexStatus {
  BUILDING
  READY
  RETIRED

  @@map("index_status")
}

/// Platform-wide: which embedding models have vectors, and which one searches use.
model EmbeddingIndex {
  model     String      @id
  dims      Int
  status    IndexStatus @default(BUILDING)
  serving   Boolean     @default(false)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @default(now()) @updatedAt @map("updated_at")

  @@map("embedding_indexes")
}

// ── Chat (Phase 5) ──────────────────────────────────────────────────────────────────────────

enum MessageRole {
  USER
  ASSISTANT

  @@map("message_role")
}

/// An answer is saved as it starts, so a dropped connection or a reload never loses it.
enum MessageStatus {
  STREAMING
  DONE
  /// Stopped by the person asking; `content` holds what had arrived.
  STOPPED
  FAILED

  @@map("message_status")
}

/// One chat. Private to the person who started it: nobody else, admins included, can read it.
model Conversation {
  id          String    @id @default(cuid(2))
  workspaceId String    @map("workspace_id")
  userId      String    @map("user_id")
  title       String    @default("")
  /// Where answers come from: `AskScope` in apps/api/src/ask/scope.ts (workspace, a
  /// collection, or picked files).
  scope       Json
  createdAt   DateTime  @default(now()) @map("created_at")
  /// Bumped by every question, so the list shows the most recent chats first.
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@index([workspaceId, userId, updatedAt(sort: Desc)])
  @@map("conversations")
}

model Message {
  id                 String        @id @default(cuid(2))
  workspaceId        String        @map("workspace_id")
  conversationId     String        @map("conversation_id")
  role               MessageRole
  /// The question, or the answer with its citations as [n] (numbered by first use).
  content            String        @default("")
  status             MessageStatus @default(DONE)
  /// "provider:model" that answered; "none" when no chat model is configured (passages only).
  model              String?
  /// Where the model ran (the data-route badge); its label as shown when it answered.
  route              AiRoute?
  routeLabel         String?       @map("route_label")
  isMock             Boolean       @default(false) @map("is_mock")
  /// Sources the route wasn't allowed to read, counted, never read ("2 restricted sources
  /// hidden").
  hiddenRestricted   Int           @default(0) @map("hidden_restricted")
  hiddenConfidential Int           @default(0) @map("hidden_confidential")
  /// The sources didn't hold the answer; the reply says so instead of guessing.
  notFound           Boolean       @default(false) @map("not_found")
  followUps          String[]      @default([]) @map("follow_ups")
  /// A failure as a code ("chat_unavailable"), never content.
  error              String?
  inputTokens        Int?          @map("input_tokens")
  outputTokens       Int?          @map("output_tokens")
  /// -1, 0 or 1 from the person asking.
  feedback           Int?
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @default(now()) @updatedAt @map("updated_at")
  workspace          Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation       Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  citations          Citation[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

/// A numbered source of an answer. The passage and title are kept as they were, but they're
/// only shown while the person can still open the file (checked on every read).
model Citation {
  id          String    @id @default(cuid(2))
  workspaceId String    @map("workspace_id")
  messageId   String    @map("message_id")
  n           Int
  chunkId     String?   @map("chunk_id")
  fileId      String?   @map("file_id")
  title       String
  page        Int?
  startMs     Int?      @map("start_ms")
  endMs       Int?      @map("end_ms")
  quote       String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  message     Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  chunk       Chunk?    @relation(fields: [chunkId], references: [id], onDelete: SetNull)
  file        File?     @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@unique([messageId, n])
  @@index([fileId])
  @@map("citations")
}

/// The text of a note (a File of kind NOTE). The body is also stored as the file's original
/// (Markdown), so notes go through the same pipeline as documents and are searchable and citable.
model Note {
  id          String    @id @default(cuid(2))
  workspaceId String    @map("workspace_id")
  fileId      String    @unique @map("file_id")
  body        String
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  file        File      @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@map("notes")
}

// ── Next (BRIEF §4): the tables exist so the model is settled; nothing reads or writes them ──

/// A connected source of files: Google Drive, Notion, Slack, Zoom or Meet recordings.
model Integration {
  id          String    @id @default(cuid(2))
  workspaceId String    @map("workspace_id")
  provider    String
  status      String    @default("disconnected")
  /// Non-secret settings only; tokens are stored envelope-encrypted when this is built.
  config      Json?
  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  files       File[]

  @@index([workspaceId])
  @@map("integrations")
}

/// Delete files after `keepDays`, for the workspace or one collection.
model RetentionPolicy {
  id           String    @id @default(cuid(2))
  workspaceId  String    @map("workspace_id")
  collectionId String?   @map("collection_id")
  keepDays     Int       @map("keep_days")
  createdAt    DateTime  @default(now()) @map("created_at")
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("retention_policies")
}

/// Files under a hold can't be deleted, by people or by retention, until it's released.
model LegalHold {
  id          String    @id @default(cuid(2))
  workspaceId String    @map("workspace_id")
  name        String
  fileIds     String[]  @default([]) @map("file_ids")
  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  releasedAt  DateTime? @map("released_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("legal_holds")
}

// ── Operations ──────────────────────────────────────────────────────────────────────────────

/// Who did what, to which target, from where. Never document content, prompts or secrets.
model AuditLog {
  id          String    @id @default(cuid(2))
  workspaceId String    @map("workspace_id")
  actorId     String?   @map("actor_id")
  /// e.g. "member.role_changed", "collection.created" (see apps/api/src/audit/actions.ts)
  action      String
  targetType  String    @map("target_type")
  targetId    String?   @map("target_id")
  ip          String?
  /// Small, non-sensitive details: names, old and new roles.
  meta        Json?
  at          DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor       User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, at(sort: Desc)])
  @@index([workspaceId, actorId, at(sort: Desc)])
  @@map("audit_logs")
}

/// Waitlist and demo-form sign-ups (the Phase 8 marketing site writes here; the old MongoDB
/// waitlist is imported into it).
model Lead {
  id        String   @id @default(cuid())
  email     String   @unique @db.Citext
  teamSize  String?  @map("team_size")
  source    String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("leads")
}

// ── AI modes and billing (Phase 6) ──────────────────────────────────────────────────────────
// Private and Managed models come from the platform's config (packages/ai settings); a
// workspace adds its own keys (BYOK) here and chooses, in its policy, which modes and models it
// allows. Restricted content is Private-only in code, whatever these rows say.

/// A workspace's own AI account (BYOK): an Anthropic, OpenAI or Google key, or any
/// OpenAI-compatible endpoint. The key is envelope-encrypted (packages/ai vault): a random data
/// key encrypts it, and the master key (local in dev, KMS in production) wraps the data key.
/// The key is write-only: only its last four characters ever leave the api.
model AiProviderConfig {
  id           String    @id @default(cuid(2))
  workspaceId  String    @map("workspace_id")
  /// An adapter id from the provider catalog: "anthropic", "openai", "google", "openai-compatible".
  provider     String
  /// What admins call it ("Finance team's Claude key").
  label        String
  /// AES-256-GCM ciphertext of the key (iv | tag | ciphertext); null for keyless endpoints.
  encryptedKey Bytes?    @map("encrypted_key")
  /// The data key, wrapped by the master key named in `keyWrapper`.
  wrappedDek   Bytes?    @map("wrapped_dek")
  /// Which master key wrapped it ("local:<key id>", "kms:<key arn>"), so keys can be rotated.
  keyWrapper   String?   @map("key_wrapper")
  keyLast4     String?   @map("key_last4")
  /// Only for "openai-compatible": the server's base URL, including /v1.
  baseUrl      String?   @map("base_url")
  /// Chat models this key may use ("claude-sonnet-4-5"); the first is its default.
  models       String[]  @default([])
  /// The last Test connection that passed, and the last failure as a code.
  verifiedAt   DateTime? @map("verified_at")
  lastError    String?   @map("last_error")
  createdById  String?   @map("created_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("ai_provider_configs")
}

/// Where a workspace's questions may be answered (BRIEF §3). One row per workspace; a missing
/// row means the defaults: Private only, Confidential stays Private.
model WorkspaceAiPolicy {
  workspaceId       String    @id @map("workspace_id")
  allowedModes      AiRoute[] @default([PRIVATE]) @map("allowed_modes")
  defaultMode       AiRoute   @default(PRIVATE) @map("default_mode")
  /// A model reference from the catalog ("private:ollama:llama3.2:3b",
  /// "byok:<config id>:claude-sonnet-4-5", "managed:anthropic:claude-…"); null = the mode's first.
  defaultModel      String?   @map("default_model")
  /// Modes besides Private allowed to read Confidential sources. Restricted is never listed:
  /// it is Private-only in code.
  confidentialModes AiRoute[] @default([]) @map("confidential_modes")
  /// Catalog models an admin turned off for this workspace.
  disabledModels    String[]  @default([]) @map("disabled_models")
  updatedById       String?   @map("updated_by_id")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_ai_policies")
}

enum UsageKind {
  AI_INPUT_TOKENS
  AI_OUTPUT_TOKENS
  TRANSCRIPTION_SECONDS
  /// A change in stored bytes (+ on upload, - on permanent delete); the sum is what's stored.
  STORAGE_BYTES

  @@map("usage_kind")
}

/// Metering (BRIEF §4 Billing): one row per thing used. Quotas and the usage charts sum these;
/// never content, only quantities.
model UsageEvent {
  id          String    @id @default(cuid(2))
  workspaceId String    @map("workspace_id")
  userId      String?   @map("user_id")
  kind        UsageKind
  quantity    BigInt
  route       AiRoute?
  model       String?
  /// What was used, when counting it twice must be impossible (a retried transcription: the
  /// file id). Unique per kind.
  subjectId   String?   @map("subject_id")
  at          DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([kind, subjectId])
  @@index([workspaceId, kind, at])
  @@map("usage_events")
}

enum Plan {
  FREE
  PRO
  BUSINESS
  ENTERPRISE

  @@map("plan")
}

enum SubscriptionStatus {
  ACTIVE
  /// Payment failed; the plan keeps working until the period ends.
  PAST_DUE
  /// Cancelled; the plan keeps working until `currentPeriodEnd`, then falls back to Free.
  CANCELLED

  @@map("subscription_status")
}

/// The workspace's plan with the payment provider (ADR 0004: Paystack first). A missing row
/// is the Free plan.
model Subscription {
  workspaceId      String             @id @map("workspace_id")
  plan             Plan               @default(FREE)
  status           SubscriptionStatus @default(ACTIVE)
  /// "paystack", or "test" for the labelled stand-in when no provider is configured.
  provider         String
  /// The provider's customer and subscription references (Paystack: customer code,
  /// subscription code); never card details.
  customerRef      String?            @map("customer_ref")
  externalId       String?            @map("external_id")
  currentPeriodEnd DateTime?          @map("current_period_end")
  updatedAt        DateTime           @default(now()) @updatedAt @map("updated_at")
  workspace        Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

/// Payment-provider webhooks already handled, so a retried delivery changes nothing twice.
/// Not a tenant table: a webhook arrives without a session and names its own workspace.
model BillingEvent {
  id           String   @id
  provider     String
  type         String
  /// The workspace the event named (not a tenant key: the webhook has no session).
  forWorkspace String?  @map("workspace_id")
  receivedAt   DateTime @default(now()) @map("received_at")

  @@map("billing_events")
}
