# Copy to .env for local development. Never commit .env.
NODE_ENV=development
LOG_LEVEL=info

# api
PORT=4000
DATABASE_URL=postgresql://sotto:sotto@localhost:5432/sotto
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://sotto:sotto@localhost:5672

# Sign-in (Better Auth). APP_URL is the origin people open: the web app, which forwards
# /api/* here, so sign-in links and passkeys belong to it.
APP_URL=http://localhost:3000
# Required in production: 32+ random characters (openssl rand -hex 32). Local runs fall back to
# a fixed development secret.
AUTH_SECRET=
# Rate limits on /api/auth (Redis): on in production, off locally unless set to "on".
AUTH_RATE_LIMIT=

# Email for sign-in links and invites: Mailpit from `pnpm deps:up` catches everything
# (http://localhost:8025). In deployments: any SMTP provider, e.g. SES's SMTP endpoint.
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Sotto <no-reply@sotto.local>

# Google and Microsoft sign-in show up only when both values are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Integration tests: any database on a Postgres you can create databases on.
TEST_DATABASE_URL=postgresql://sotto:sotto@localhost:5432/postgres

# worker
WORKER_HEALTH_PORT=4100
WORKER_CONCURRENCY=2
WORKER_MAX_DOCUMENT_MB=100

# AI providers, as "provider:model" (packages/ai/src/settings.ts). Embeddings always run in your
# cluster: Ollama by default (`ollama pull nomic-embed-text`), or fake:fake-hash, a labelled mock.
AI_EMBEDDINGS=ollama:nomic-embed-text
# Meeting notes. Empty → labelled basic notes. e.g. ollama:llama3.2:3b
AI_PRIVATE_CHAT=
# The model that answers in Ask ("provider:model"); empty uses AI_PRIVATE_CHAT. With neither,
# Ask answers with the matching passages only, labelled on screen. Restricted (and, until Phase 6,
# Confidential) sources never reach a model whose server is THIRD_PARTY.
AI_ASK_CHAT=
# Master key for workspace API keys (BYOK), 32 random bytes: `openssl rand -base64 32`.
# Unset → workspaces can't save keys (the AI settings screen says so). Keep it secret; losing it
# loses every saved key. AI_KEYS_MASTER_PREVIOUS (comma separated) opens keys from before a rotation.
AI_KEYS_MASTER=
AI_KEYS_MASTER_PREVIOUS=
# Questions one person may ask per minute.
ASK_RATE_PER_MINUTE=20
# Relevance floor override (cosine 0–1); each embedding model has a measured default.
# ASK_MIN_SIMILARITY=0.65
OLLAMA_URL=http://localhost:11434
# Any OpenAI-style server (vLLM, TEI, a hosted API); say who runs it.
AI_OPENAI_COMPATIBLE_URL=
AI_OPENAI_COMPATIBLE_KEY=
AI_OPENAI_COMPATIBLE_LOCATION=IN_CLUSTER

# transcriber
TRANSCRIBER_URL=http://localhost:5000
# Phase 1 ships only the labelled mock engine; faster-whisper arrives in Phase 4.
TRANSCRIBER_ENGINE=fake

# Object storage: SeaweedFS from `pnpm deps:up` locally, S3 on AWS (leave S3_ENDPOINT and the
# keys empty there: the server's IAM role signs requests). Browsers upload straight to it with
# presigned URLs, so S3_PUBLIC_ENDPOINT must be an address the browser can reach.
S3_ENDPOINT=http://localhost:8333
S3_PUBLIC_ENDPOINT=
S3_BUCKET=sotto-files
S3_REGION=eu-west-2
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=files
# Largest upload, in bytes (default 2 GiB).
UPLOAD_MAX_BYTES=

# Integration tests that upload need an S3 server too (the bucket is created if missing).
TEST_S3_ENDPOINT=http://localhost:8333
